rules_version = '2';

/**
 * Hardened rules.
 *
 * Fixes F-07: `allow create: if request.auth != null || true` made the
 * analytics collection world-writable, on a collection holding email
 * addresses.
 *
 * Principle: the client may READ its own data. Every write that carries
 * entitlement (versions, scans, quotas, verification, events, subscriptions)
 * goes through the Admin SDK in an API route and is denied here. Admin SDK
 * bypasses rules, so "deny all" is the correct rule for those collections.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profile: readable by its owner, written server-side only (plan lives here).
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Document metadata: owner reads. Writes go through /api/documents so
    // that versioning, quota and provenance cannot be skipped.
    match /documents/{docId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if false;
      // Deleting your own document stays a client action: it is destructive
      // for the user only, and is convenient offline.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Immutable version history. Never client-writable: this is the evidence.
    match /documentVersions/{versionId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /scans/{scanId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    match /scanFindings/{findingId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // Ownership proof. Read your own; only the server can issue or verify.
    match /domainVerifications/{verificationId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Counters and analytics: server-only, both directions. The client has no
    // reason to read another user's counters or to write its own.
    match /quotas/{quotaId} {
      allow read, write: if false;
    }

    match /events/{eventId} {
      allow read, write: if false;
    }

    match /subscriptions/{subId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /auditLog/{entryId} {
      allow read, write: if false;
    }

    match /organisations/{orgId} {
      allow read: if signedIn() && request.auth.token.orgId == orgId;
      allow write: if false;
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}